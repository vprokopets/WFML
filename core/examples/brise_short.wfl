Model {
    xor Surrogate {
        TPE {
            AccuracyThreshold -> float
            [AccuracyThreshold > 0.7]
        }
        GPR {
            AccuracyThreshold -> float
            [AccuracyThreshold > 0.8]
        }
    }
}
Context {
    SearchSpace {
        xor Structure {
            Flat {
                [fcard.Model.Surrogate = 1]
            }
            Hierarchical {
                [fcard.Model.Surrogate = 2]
            }
        }
    }
}